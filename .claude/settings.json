{
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/.claude/notify.sh\" Notification", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$HOME/.claude/notify.sh\" Stop", "timeout": 5 }
        ]
      }
    ]
  }
}
